OPENAI_API_KEY=your-api-key-here
PINECONE_API_KEY=your-pinecone-api-key-here

# Optional: powers the comparison chat's web-search fallback for questions
# outside the user's saved listings (agent/comparison_chat.py). Without
# this set, the chat still works normally, it just can't answer anything
# beyond the saved listing data - it says so rather than guessing.
# Free key: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# Optional: LangSmith tracing
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=carscout
