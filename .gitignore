# Streamlit secrets (if you ever add a secrets.toml alongside .env)
.streamlit/secrets.toml

# OS/editor cruft
.DS_Store
.vscode/
.idea/

# Logs (if debug_retrieve.py or ingest.py write log files)
*.log

# Jupyter, if you end up prototyping in notebooks
.ipynb_checkpoints/

# Test/coverage artifacts, if you add tests later
.pytest_cache/
.coverage

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables
.env

# Dataset (junction to external folder, never track raw data)
data/

# Filtered/cached data derived from the datasets above. The two shortlist
# parquet files are small (~25KB each), already filtered to the 6-vehicle
# demo shortlist, and needed at runtime (price/recall checks) - committed
# so Render has them without access to the multi-GB raw source CSVs.
data_cache/*
!data_cache/vehicles_shortlist.parquet
!data_cache/recalls_shortlist.parquet

# Local SQLite memory store - Render uses Postgres instead (DATABASE_URL).
data_cache/memory.db

